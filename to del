~/kilolib$ sed -n '160,230p' message_send.S

    ; if (bitidex--) goto sendbit
    dec bitidx
    brne sendbit

    ; if (byteidx--) goto sendbyte
    dec byteidx
    brne sendbyte

    ; ACSR |= (1<<ACI)
    in tmpreg1, ACSR
    ori tmpreg1, (1<<ACI)
    out ACSR, tmpreg1
    ; IR_DDR = ddrreg
    out IR_DDR, ddrreg

    ; IR_PORT &= ~(tx_mask)
    lds tmpreg2, tx_mask
    com tmpreg2
    in tmpreg1, IR_PORT
    and tmpreg1, tmpreg2
    out IR_PORT, tmpreg1

    ; restore interrupt state
    ; SREG = sreg
    out SREG, sreg
    return 1
